            "title": "Env",
            "type": "string"
          },
          "plugins_loaded": {
            "items": {
              "type": "string"
            },
            "title": "Plugins Loaded",
            "type": "array"
          },
          "status": {
            "title": "Status",
            "type": "string"
          },
          "version": {
            "title": "Version",
