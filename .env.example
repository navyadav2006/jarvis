# Copy this file to .env and adjust values for your machine.
# Any field here can also be set as a real environment variable, which
# takes precedence over .env, which in turn takes precedence over
# config/settings.yaml. See docs/architecture.md's Phase 3 section.
#
# Only settings.yaml supports environment-variable overrides. The other
# four config domains (permissions.yaml, voice.yaml, memory.yaml,
# plugins.yaml) are meant to be edited directly — see config/examples/
# for populated examples of each.

# --- app ---
APP__NAME=Jarvis
APP__ENV=development
APP__DEBUG=true

# --- logging ---
LOGGING__LEVEL=DEBUG
LOGGING__CONSOLE=true

# --- paths ---
PATHS__DATA_DIR=data
PATHS__PLUGINS_DIR=plugins
PATHS__VAULT_DIR=vault

# --- api ---
API__HOST=127.0.0.1
API__PORT=8756

# --- config (live reload) ---
CONFIG__LIVE_RELOAD=true
CONFIG__POLL_INTERVAL_SECONDS=2.0
